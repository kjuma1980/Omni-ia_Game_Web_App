# ---------------------------------------------------------------------------
#  Creador 2D — plantilla de variables de entorno
#  Copie este archivo a `.env` y rellene los valores reales.
#  `.env` esta en .gitignore: NUNCA se versiona.
#  NINGUNA clave real (ni de base de datos ni de proveedores cloud) debe
#  escribirse en este archivo de ejemplo.
# ---------------------------------------------------------------------------

# --- Base de datos PostgreSQL local ---------------------------------------
# Formato: postgresql://USUARIO:CLAVE@HOST:PUERTO/BASEDEDATOS?schema=public
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/Creador_2d?schema=public"

# --- Servidor --------------------------------------------------------------
# El puerto 3000 esta reservado y no debe usarse. 3142 lo ocupa el frontend.
PORT=4310
HOST=127.0.0.1
NODE_ENV=development

# Origenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:3142,http://127.0.0.1:3142,tauri://localhost,http://tauri.localhost

# --- Autenticacion ---------------------------------------------------------
# Genere cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=GENERE_UN_SECRETO_ALEATORIO_DE_48_BYTES
JWT_REFRESH_SECRET=GENERE_OTRO_SECRETO_ALEATORIO_DISTINTO
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# --- Credenciales de la semilla (solo entorno local de desarrollo) ---------
SEED_ADMIN_EMAIL=admin@creador2d.local
SEED_ADMIN_PASSWORD=DEFINA_UNA_CLAVE_LOCAL
SEED_CREATOR_EMAIL=creador@creador2d.local
SEED_CREATOR_PASSWORD=DEFINA_UNA_CLAVE_LOCAL

# --- Proveedores de IA -----------------------------------------------------
# Las claves cloud viven UNICAMENTE en el proceso del backend, jamas en el
# navegador. Dejar vacio desactiva el proveedor: el modulo entero es opcional
# y el editor funciona al 100% sin IA.
AI_ENABLED=false
AI_DEFAULT_PROVIDER=ollama
# Motor local (no requiere clave).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Proveedores cloud (opcionales).
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Fondos de parallax generados con ComfyUI ------------------------------
# Reutiliza el ComfyUI que Omni IA Game ya levanta. No necesita ninguna clave.
# Requiere el nodo "Model Patch Seamless (mtb)" para el tileado horizontal.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_BG_CHECKPOINT=dreamshaperXL_lightningDPMSDE.safetensors
COMFYUI_BG_STEPS=8
COMFYUI_BG_CFG=2
COMFYUI_BG_SAMPLER=dpmpp_sde
COMFYUI_BG_SCHEDULER=karras
