# ============================================================
# OMNI-IA GAME — auth-server · PRODUCCIÓN (hPanel Hostinger / VPS)
# Copia este archivo como .env en el servidor y completa los valores.
# NUNCA subir este archivo con valores reales al repositorio.
# ============================================================

PORT=4010
HOST=0.0.0.0

# --- SMTP Hostinger (correo profesional) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=omniia.edu@fenixdev.cloud
SMTP_PASS=TU_CONTRASENA_SMTP_REAL
MAIL_FROM=omniia.edu@fenixdev.cloud
MAIL_FROM_NAME=Omni-IA Game
APP_DOMAIN=https://fenixdev.cloud
MAIL_FROM_LICENSES=omniia.edu.licencias@fenixdev.cloud

# --- Seguridad ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=GENERA_UN_SECRET_ALEATORIO_LARGO
JWT_EXPIRES_IN=12h
CODE_TTL_MINUTES=15

# --- Cuenta admin inicial ---
# Cambia esta contraseña por una fuerte y única. Se crea solo la primera vez.
ADMIN_BOOTSTRAP_EMAIL=admin@tu-dominio.com
ADMIN_BOOTSTRAP_PASSWORD=TU_CONTRASENA_SECTETA_Y_SEGURA_AQUI

# --- Registro y firma de licencias ---
# Clave secreta que autoriza el registro desde scripts externos.
LICENSE_REGISTER_KEY=GENERA_UN_SECRETO_LARGO

# Clave privada Ed25519 (la MISMA que firma las licencias de la app).
# Opción A: contenido PEM (escapa saltos de línea como \n)
# LICENSE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGE...\n-----END PRIVATE KEY-----\n
# Opción B: ruta a un archivo .pem subido al servidor (recomendada)
LICENSE_PRIVATE_KEY_PATH=/var/www/omni-auth/keys/ed25519_private.pem

# --- CORS / proxy ---
# Dominios de producción (separados por coma). Los orígenes Tauri locales siempre están permitidos.
CORS_ORIGINS=https://fenixdev.cloud,https://www.fenixdev.cloud
# Requerido en hPanel/VPS (proxy) para que el rate limiting use la IP real del cliente.
TRUST_PROXY=1

# --- Recordatorios de expiración ---
REMINDERS_ENABLED=true
REMINDER_CHECK_INTERVAL_MS=3600000
REMINDER_THRESHOLD_PCT=0.20
REMINDER_MIN_GAP_DAYS=7

# --- VPS (opcional, PM2) ---
# PM2_PATH=/usr/local/bin/pm2
# PM2_APP_NAME=omni-auth
