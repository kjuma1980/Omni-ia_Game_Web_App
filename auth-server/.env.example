PORT=4010
HOST=0.0.0.0

# SMTP Hostinger (correo profesional)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=omniia.edu@fenixdev.cloud
SMTP_PASS=TU_CONTRASENA_SMTP_AQUI
MAIL_FROM=omniia.edu@fenixdev.cloud
MAIL_FROM_NAME=Omni-IA Game
APP_DOMAIN=https://fenixdev.cloud

# Seguridad
JWT_SECRET=
JWT_EXPIRES_IN=12h
CODE_TTL_MINUTES=15

# Cuenta de administrador inicial (se crea/promueve automáticamente al arrancar)
# Contraseña mínima: 10 caracteres
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
MAIL_FROM_LICENSES=omniia.edu.licencias@fenixdev.cloud

# Registro administrativo de licencias (F3)
# Clave que autoriza POST /api/licenses/register desde el generador de licencias.
# Si está vacía, solo cuentas admin autenticadas pueden registrar licencias.
LICENSE_REGISTER_KEY=

# Firma de licencias en el servidor (F6 — panel "Generar")
# La MISMA clave privada Ed25519 que usa scratch/generate_license.mjs.
# Usa UNA de las dos: contenido PEM (escapar saltos como \n) o ruta al archivo.
# LICENSE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# LICENSE_PRIVATE_KEY_PATH=/ruta/a/ed25519_private.pem

# CORS adicional (F6): dominios de producción separados por coma
# Ej. https://fenixdev.cloud,https://www.fenixdev.cloud
CORS_ORIGINS=

# Activa trust proxy (requerido en hPanel/VPS para rate limiting con IP real)
TRUST_PROXY=1

# Recordatorios de expiración (F4)
REMINDERS_ENABLED=true
REMINDER_CHECK_INTERVAL_MS=3600000
REMINDER_THRESHOLD_PCT=0.20
REMINDER_MIN_GAP_DAYS=7
