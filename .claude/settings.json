{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/proteger.mjs",
            "timeout": 15,
            "statusMessage": "Comprobando rutas protegidas..."
          }
        ]
      }
    ]
  }
}
