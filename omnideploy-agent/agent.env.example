# Configuracion del agente OmniDeploy.
#
# Copia este fichero como `agent.env` y rellena la clave maestra.
# `agent.env` NO se sube al repositorio: lleva el secreto que autoriza a
# registrar dispositivos nuevos contra tu relay.

# Relay al que se conecta el agente. Solo salientes: no se abre ningun puerto.
OMNI_RELAY_URL=https://omni-api.fenixdev.cloud

# Clave maestra del dueno. La misma que OMNIDEPLOY_MASTER_KEY en el servidor.
# Solo se usa UNA vez, para el registro inicial; despues manda el deviceToken
# que queda guardado en agent.json.
OMNI_MASTER_KEY=

# ComfyUI local. Se habla con el por 127.0.0.1: no hace falta exponerlo.
OMNI_COMFYUI_URL=http://127.0.0.1:8188

# Nombre con el que aparece en el panel de administracion.
OMNI_FRIENDLY_NAME=PC del estudio

# ---------------------------------------------------------------------------
#  QUE GENERA ESTE EQUIPO
# ---------------------------------------------------------------------------
#  El cliente manda parametros -prompt, tamano, semilla- y un TIPO de trabajo.
#  NUNCA manda el grafo: su workflow nombra SUS modelos, y este equipo tiene
#  otros. Quien elige el grafo es este fichero.
#
#  Cada ruta apunta a un JSON exportado desde ComfyUI en FORMATO API
#  ("Save (API format)"), no el guardado normal.
#
#  Lo que no se rellene, no se ofrece: un trabajo de ese tipo devolvera un aviso
#  claro al cliente en vez de fallar de forma rara.
#
#  Imagen es la excepcion: si se deja vacia, el agente monta un texto-a-imagen
#  basico con un checkpoint que EXISTA en este equipo.

OMNI_WORKFLOW_IMAGEN=
OMNI_WORKFLOW_VIDEO=
OMNI_WORKFLOW_VOZ=
OMNI_WORKFLOW_MUSICA=
OMNI_WORKFLOW_SFX=
OMNI_WORKFLOW_3D=

# Compatibilidad: si solo se usa este equipo para imagenes, basta con esta.
# Se usa cuando la especifica del tipo esta vacia.
OMNI_WORKFLOW=

# Checkpoint del workflow de emergencia de imagen. Vacio = se pregunta a
# ComfyUI cual tiene y se elige uno de proposito general.
OMNI_CHECKPOINT=

# ---------------------------------------------------------------------------
#  TEXTOS: guiones, dialogos y NPCs con Ollama
# ---------------------------------------------------------------------------
#  Permite que un equipo sin GPU escriba narrativa contra la de este. Es el
#  mismo caso que las imagenes: un portatil de aula no puede con un modelo de
#  12B, pero este equipo si.
#
#  Ollama tiene que estar encendido aqui. El instalador de Omni IA Game ya sabe
#  instalarlo y descargar el modelo.

OMNI_OLLAMA_URL=http://localhost:11434

# Modelo con el que se responde. Vacio = se pregunta a Ollama cual tiene
# descargado y se elige el primero util. Si se escribe uno que no este
# instalado, el agente avisa y usa otro en vez de fallar en cada trabajo.
OMNI_OLLAMA_MODEL=
